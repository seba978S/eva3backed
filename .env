# ── Base de datos ──────────────────────────────────
# Pon USE_SQLITE=True para desarrollo local rápido con SQLite.
# Cuando migres a AWS EC2 con PostgreSQL, pon USE_SQLITE=False y completa las variables.
USE_SQLITE=True

DB_NAME=petcare_db
DB_USER=petcare_user
DB_PASSWORD=changeme
DB_HOST=localhost
DB_PORT=5432

# ── Django ────────────────────────────────────────
SECRET_KEY=django-insecure-cambia-esto-en-produccion-abc123xyz
DEBUG=True
ALLOWED_HOSTS=*
