# ==============================================================================
# PetCare - Plantilla de Variables de Entorno (.env.example)
# Copia este archivo como .env y ajusta los valores para tu entorno.
#
#   Windows: copy .env.example .env
#   Linux:   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BASE DE DATOS (PostgreSQL / SQLite Fallback)
# ------------------------------------------------------------------------------
# Para desarrollo local rápido con SQLite, activa USE_SQLITE=True.
# Para conectar a PostgreSQL (local o AWS EC2), define USE_SQLITE=False y completa:
USE_SQLITE=False

# Credenciales de conexión a PostgreSQL
DB_NAME=petcare_db
DB_USER=petcare_user
DB_PASSWORD=tu_password_segura
DB_HOST=localhost
DB_PORT=5432

# (Opcional) URL de conexión directa si usas dj-database-url o servicios gestionados (RDS/Render):
# DATABASE_URL=postgres://petcare_user:tu_password_segura@localhost:5432/petcare_db

# ------------------------------------------------------------------------------
# 2. CONFIGURACIÓN DE DJANGO
# ------------------------------------------------------------------------------
# Genera una clave segura para producción con:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-cambia-esta-clave-secreta-para-produccion-1234567890

# En desarrollo mantener True; en producción (AWS EC2) debe ser False
DEBUG=True

# Hosts permitidos separados por coma (ej. localhost,127.0.0.1,54.xxx.xxx.xxx)
ALLOWED_HOSTS=localhost,127.0.0.1,*

